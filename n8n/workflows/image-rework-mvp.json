{
  "name": "Image Rework MVP",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1600,
        300
      ],
      "id": "6feef024-a81f-4442-ad06-40452ac4948f",
      "name": "Manual Trigger"
    },
    {
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "reference_url",
              "type": "stringValue",
              "stringValue": "https://example.com/reference.jpg"
            },
            {
              "name": "runId",
              "type": "stringValue",
              "stringValue": "={{ $now.toMillis() }}"
            },
            {
              "name": "nanobanana_base64_path",
              "type": "stringValue",
              "stringValue": "data.image_base64"
            },
            {
              "name": "front_prompt",
              "type": "stringValue",
              "stringValue": "<<FRONT_PROMPT_PLACEHOLDER>>"
            },
            {
              "name": "profile_prompt",
              "type": "stringValue",
              "stringValue": "<<PROFILE_PROMPT_PLACEHOLDER>>"
            }
          ]
        },
        "include": "none",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        -1400,
        300
      ],
      "id": "0af88e66-d757-4921-b41a-5d45c857fc5b",
      "name": "Set Reference"
    },
    {
      "parameters": {
        "name": "={{ $node[\"Set Reference\"].json.runId }}",
        "driveId": {
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "mode": "id",
          "value": "={{ $env.GDRIVE_IMAGE_REWORK_FOLDER_ID }}",
          "cachedResultName": "Image Rework"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -1200,
        300
      ],
      "id": "9e4a04b2-086f-4d84-a745-d17db39d7a52",
      "name": "Google Drive - Create Folder",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "googleDriveOauth2",
          "name": "Google Drive"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $node[\"Set Reference\"].json.reference_url }}",
        "authentication": "none",
        "options": {
          "response": {
            "responseFormat": "file"
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1000,
        300
      ],
      "id": "a278f43c-f6df-4a97-9cfb-376596a88907",
      "name": "HTTP Request - Download reference"
    },
    {
      "parameters": {
        "inputDataFieldName": "data",
        "name": "={{ 'reference_' + $node[\"Set Reference\"].json.runId + '.' + (($node[\"Set Reference\"].json.reference_url || '').split('?')[0].split('.').pop() || 'jpg') }}",
        "driveId": {
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "mode": "id",
          "value": "={{ $node[\"Google Drive - Create Folder\"].json.id }}"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -800,
        300
      ],
      "id": "bb952307-8b6c-4171-9367-8d6e75ea1bf2",
      "name": "Google Drive - Upload reference",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "googleDriveOauth2",
          "name": "Google Drive"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NANOBANANA_API_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"image_url\": $node[\"Set Reference\"].json.reference_url, \"prompt\": $node[\"Set Reference\"].json.front_prompt, \"view\": \"front\" } }}",
        "options": {
          "response": {
            "responseFormat": "json"
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -600,
        150
      ],
      "id": "87b0107b-bc17-40de-876c-56caa227df51",
      "name": "HTTP Request - NanoBanana FRONT",
      "credentials": {
        "httpHeaderAuth": {
          "id": "nanoBananaApi",
          "name": "NanoBanana API"
        }
      }
    },
    {
      "parameters": {
        "mode": "jsonToBinary",
        "convertAllData": false,
        "sourceKey": "={{ $node[\"Set Reference\"].json.nanobanana_base64_path }}",
        "destinationKey": "image",
        "options": {
          "dataIsBase64": true,
          "fileName": "front.png",
          "mimeType": "image/png"
        }
      },
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1,
      "position": [
        -400,
        150
      ],
      "id": "1b1d5d13-3155-4375-8147-3550a073e714",
      "name": "Move Binary Data - FRONT"
    },
    {
      "parameters": {
        "operation": "resize",
        "dataPropertyName": "image",
        "width": 9999,
        "height": 1250,
        "resizeOption": "maximumArea",
        "options": {
          "destinationKey": "image",
          "format": "webp"
        }
      },
      "type": "n8n-nodes-base.editImage",
      "typeVersion": 1,
      "position": [
        -200,
        150
      ],
      "id": "4fe0f769-b384-46e8-b3a2-cdd76aee742a",
      "name": "Edit Image - FRONT"
    },
