        "httpHeaderAuth": {
          "id": "nanoBananaApi",
          "name": "NanoBanana API"
        }
      }
    },
    {
      "parameters": {
        "mode": "jsonToBinary",
        "convertAllData": false,
        "sourceKey": "={{ $node[\"Set Reference\"].json.nanobanana_base64_path }}",
