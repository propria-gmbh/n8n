# Shopify admin domain without protocol (e.g. mystore.myshopify.com)
SHOPIFY_STORE_DOMAIN=
# Private app or custom app Admin API access token
SHOPIFY_ACCESS_TOKEN=
# Optional overrides
SHOPIFY_API_VERSION=2024-10
SHOPIFY_PAGE_SIZE=50
SHOPIFY_MAX_PRODUCTS=200
# Local folder to store converted images
OUTPUT_DIR=converted
# WebP quality (0-100)
WEBP_QUALITY=80
